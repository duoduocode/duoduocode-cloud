<!-- pages/transaction/detail/detail.wxml -->
<view class="container" wx:if="{{!loading}}">
  <!-- 金额区域 -->
  <view class="amount-section">
    <text class="amount-num {{transactionType === 'expense' ? 'expense' : 'income'}}">
      {{transactionType === 'expense' ? '-' : '+'}}￥{{amount}}
    </text>
    <text class="category-label">{{categoryName}}</text>
  </view>

  <!-- 详细信息 -->
  <view class="card">
    <view class="info-row">
      <text class="info-label">日期</text>
      <text class="info-value">{{date}} {{time}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">分类</text>
      <text class="info-value">{{categoryName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">账户</text>
      <text class="info-value">{{accountName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">方式</text>
      <text class="info-value">{{mode === 'expense' ? '支出' : mode === 'income' ? '收入' : mode === 'transfer' ? '转账' : '还款'}}</text>
    </view>
    <view class="info-row" wx:if="{{description}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{description}}</text>
    </view>
  </view>

  <!-- 标签 -->
  <view class="card" wx:if="{{tagNames.length > 0}}">
    <view class="info-row">
      <text class="info-label">标签</text>
      <view class="tag-list">
        <text class="tag-chip" wx:for="{{tagNames}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 分录列表 -->
  <view class="card" wx:if="{{entries.length > 0}}">
    <view class="card-title">分录明细</view>
    <view class="entry-item" wx:for="{{entries}}" wx:key="*this">
      <text class="entry-account">{{item.accountName}}</text>
      <text class="entry-amount {{item.type === 'credit' ? 'income' : 'expense'}}">
        {{item.type === 'credit' ? '+' : '-'}}￥{{item.amount}}
      </text>
    </view>
  </view>

  <!-- 退款信息 -->
  <view class="card" wx:if="{{refundStatus !== 'none'}}">
    <view class="info-row">
      <text class="info-label">退款状态</text>
      <text class="info-value {{refundStatus === 'full' ? 'income' : 'warn'}}">
        {{refundStatus === 'full' ? '已全额退款' : '已部分退款'}}
      </text>
    </view>
    <view class="info-row" wx:if="{{refundedAmount > 0}}">
      <text class="info-label">已退金额</text>
      <text class="info-value income">￥{{refundedAmount}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <view class="action-btn" bindtap="goEdit">
      <text>编辑</text>
    </view>
    <view class="action-btn warn" bindtap="deleteTransaction">
      <text>删除</text>
    </view>
    <view class="action-btn" wx:if="{{transactionType === 'expense' && refundStatus !== 'full'}}" bindtap="showRefund">
      <text>退款</text>
    </view>
  </view>

  <!-- 退款弹窗 -->
  <view class="modal-mask" wx:if="{{showRefundPanel}}" catchtap="hideRefund"></view>
  <view class="refund-panel" wx:if="{{showRefundPanel}}">
    <view class="panel-header">
      <text class="panel-title">退款</text>
      <text class="panel-close" bindtap="hideRefund">X</text>
    </view>
    <view class="panel-body">
      <view class="panel-item">
        <text class="panel-label">退款金额</text>
        <input class="panel-input" type="digit" value="{{refundAmount}}" bindinput="onRefundAmountInput"/>
      </view>
      <view class="panel-item">
        <text class="panel-label">退款日期</text>
        <picker mode="date" value="{{refundDate}}" bindchange="onRefundDateChange">
          <view class="date-picker">{{refundDate}}</view>
        </picker>
      </view>
      <view class="panel-item">
        <text class="panel-label">退款原因</text>
        <input class="panel-input" placeholder="选填" value="{{refundReason}}" bindinput="onRefundReasonInput"/>
      </view>
    </view>
    <view class="panel-footer">
      <view class="btn-confirm" bindtap="submitRefund">确认退款</view>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-wrap" wx:if="{{loading}}">
  <text class="loading-text">加载中...</text>
</view>
