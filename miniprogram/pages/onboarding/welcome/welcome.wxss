/* pages/onboarding/welcome/welcome.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F8EF 0%, #FFFFFF 60%);
  padding: 40px 32px;
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56px;
}

.logo-wrap {
  width: 88px;
  height: 88px;
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
  box-shadow: 0 8px 24px rgba(7, 193, 96, 0.3);
}

.logo-text {
  font-size: 44px;
  color: #fff;
  font-weight: bold;
}

.app-name {
  font-size: 28px;
  font-weight: 700;
  color: #333;
  margin-bottom: 12px;
}

.app-slogan {
  font-size: 16px;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

/* 加载中 */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.spinner {
  width: 36px;
  height: 36px;
  border: 3px solid #E0E0E0;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-hint {
  font-size: 14px;
  color: #999;
}

/* 登录失败 */
.fail-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.fail-icon {
  font-size: 48px;
}

.fail-text {
  font-size: 15px;
  color: #666;
  text-align: center;
  line-height: 1.6;
}

.retry-btn {
  width: 200px;
  padding: 14px;
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-radius: 28px;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 4px 16px rgba(7, 193, 96, 0.3);
}
