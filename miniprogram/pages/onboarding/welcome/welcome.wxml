<!-- pages/onboarding/welcome/welcome.wxml -->
<view class="container">
  <view class="brand-section">
    <view class="logo-wrap">
      <text class="logo-text">记</text>
    </view>
    <text class="app-name">多多记账</text>
    <text class="app-slogan">轻松记账，智慧理财</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{status === 'loading'}}" class="loading-section">
    <view class="spinner"></view>
    <text class="loading-hint">正在连接...</text>
  </view>

  <!-- 登录失败 -->
  <view wx:if="{{status === 'fail'}}" class="fail-section">
    <view class="fail-icon">😕</view>
    <text class="fail-text">{{failMsg}}</text>
    <view class="retry-btn" bindtap="retryLogin">重新连接</view>
  </view>
</view>
