/* pages/category/category/category.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 8px 16px;
  background: #fff;
  gap: 10px;
}

.search-input-wrap {
  flex: 1;
}

.search-input {
  width: 100%;
  height: 34px;
  background: #F0F0F0;
  border-radius: 17px;
  padding: 0 16px;
  font-size: 14px;
  box-sizing: border-box;
}

.search-icon text {
  font-size: 14px;
  color: #07C160;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 16px 12px;
  gap: 12px;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  border-radius: 8px;
  font-size: 14px;
  color: #666;
  background: #F5F5F5;
}

.tab-item.active {
  background: #07C160;
  color: #fff;
}

/* 分类列表 */
.cat-scroll {
  flex: 1;
  padding: 8px 16px;
}

.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 14px 16px;
  margin-bottom: 2px;
}

.cat-row:first-child {
  border-radius: 12px 12px 0 0;
}

.cat-row:last-child {
  border-radius: 0 0 12px 12px;
  margin-bottom: 8px;
}

.cat-row:first-child:last-child {
  border-radius: 12px;
}

.child-row {
  padding-left: 36px;
}

.cat-left {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}

.expand-icon {
  font-size: 11px;
  color: #999;
  width: 16px;
  text-align: center;
}

.child-indent {
  width: 16px;
}

.cat-icon {
  font-size: 20px;
}

.cat-name {
  font-size: 15px;
  color: #333;
}

.cat-count {
  font-size: 12px;
  color: #ccc;
}

.cat-right {
  flex-shrink: 0;
}

.edit-btn {
  font-size: 13px;
  color: #07C160;
  padding: 4px 8px;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 60px 0;
  color: #999;
  font-size: 15px;
}

/* FAB */
.create-fab {
  position: fixed;
  right: 24px;
  bottom: 32px;
  width: 56px;
  height: 56px;
  background: #07C160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(7, 193, 96, 0.4);
}

.create-fab text {
  color: #fff;
  font-size: 28px;
  font-weight: 300;
  line-height: 1;
}
