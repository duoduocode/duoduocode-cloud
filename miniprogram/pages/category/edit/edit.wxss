/* pages/category/edit/edit.wxss */
.container {
  padding: 16px;
  background: #F5F5F5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 0 16px;
  margin-bottom: 12px;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
}

.form-label {
  font-size: 15px;
  color: #333;
  flex-shrink: 0;
}

.form-input {
  width: 200px;
  height: 36px;
  background: #F5F5F5;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  text-align: right;
  color: #333;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  gap: 4px;
}

.prefix {
  font-size: 15px;
  color: #999;
}

/* 图标选择器 */
.icon-selector {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  background: #F5F5F5;
  border-radius: 8px;
}

.current-icon {
  font-size: 22px;
}

.arrow-down {
  font-size: 11px;
  color: #999;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding-bottom: 16px;
}

.icon-item {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #F5F5F5;
}

.icon-item text {
  font-size: 20px;
}

.icon-item.selected {
  background: #E8F8EF;
  border: 2px solid #07C160;
}

/* 类型单选 */
.type-radio-group {
  display: flex;
  gap: 8px;
}

.type-radio {
  padding: 8px 24px;
  border-radius: 8px;
  background: #F5F5F5;
  font-size: 14px;
  color: #666;
}

.type-radio.active {
  background: #07C160;
  color: #fff;
}

/* picker */
.picker-value {
  font-size: 15px;
  color: #333;
  padding: 8px 12px;
  background: #F5F5F5;
  border-radius: 8px;
}

/* 操作按钮 */
.action-section {
  margin-top: 24px;
}

.save-btn {
  background: #07C160;
  color: #fff;
  text-align: center;
  padding: 14px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.delete-btn {
  text-align: center;
  padding: 14px;
  border: 1px solid #FA5151;
  border-radius: 12px;
  color: #FA5151;
  font-size: 15px;
  margin-top: 12px;
}
