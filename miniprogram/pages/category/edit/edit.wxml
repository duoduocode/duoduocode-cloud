<!-- pages/category/edit/edit.wxml -->
<view class="container">
  <!-- 名称 -->
  <view class="card">
    <view class="form-item">
      <text class="form-label">分类名称</text>
      <input class="form-input" placeholder="请输入名称" value="{{name}}" bindinput="onNameInput"/>
    </view>
  </view>

  <!-- 图标 -->
  <view class="card">
    <view class="form-item">
      <text class="form-label">图标</text>
      <view class="icon-selector" bindtap="toggleIconPicker">
        <text class="current-icon">{{icon}}</text>
        <text class="arrow-down">▼</text>
      </view>
    </view>
    <view class="icon-grid" wx:if="{{showIconPicker}}">
      <view class="icon-item {{item === icon ? 'selected' : ''}}" wx:for="{{iconList}}" wx:key="*this" bindtap="selectIcon" data-icon="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 类型 -->
  <view class="card">
    <view class="form-item">
      <text class="form-label">类型</text>
      <view class="type-radio-group">
        <view class="type-radio {{type === 'expense' ? 'active' : ''}}" bindtap="onTypeChange" data-value="expense">
          <text>支出</text>
        </view>
        <view class="type-radio {{type === 'income' ? 'active' : ''}}" bindtap="onTypeChange" data-value="income">
          <text>收入</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 父分类选择 -->
  <view class="card" wx:if="{{!isEdit}}">
    <view class="form-item">
      <text class="form-label">父分类 (可选)</text>
      <picker mode="selector" range="{{parentCategories}}" range-key="name" bindchange="onParentChange">
        <view class="picker-value">{{parentId && parentCategories.length > 0 ? parentCategories[parentId].name : '无(顶级分类)'}}</view>
      </picker>
    </view>
  </view>

  <!-- 预算设置 -->
  <view class="card">
    <view class="form-item">
      <text class="form-label">月预算 (可选)</text>
      <view class="form-input-wrap">
        <text class="prefix">￥</text>
        <input class="form-input" type="digit" placeholder="0.00" value="{{budgetAmount}}" bindinput="onBudgetInput"/>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <view class="save-btn" bindtap="save">
      <text>{{isEdit ? '更新分类' : '创建分类'}}</text>
    </view>
    <view class="delete-btn" wx:if="{{isEdit}}" bindtap="deleteCategory">
      <text>删除分类</text>
    </view>
  </view>
</view>
