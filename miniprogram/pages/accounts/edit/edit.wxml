<!-- pages/accounts/edit.wxml - 编辑账户页 -->
<view class="container">
  <!-- 账户类型选择 -->
  <view class="form-section">
    <text class="form-label">账户类型<text class="type-hint">（不可更改）</text></text>
    <view class="type-selector type-disabled">
      <view class="type-option {{formData.type === 'asset' ? 'active' : ''}}" data-type="asset">
        <text class="type-icon">💰</text>
        <text class="type-text">资产</text>
      </view>
      <view class="type-option {{formData.type === 'liability' ? 'active' : ''}}" data-type="liability">
        <text class="type-icon">💳</text>
        <text class="type-text">负债</text>
      </view>
      <view class="type-option {{formData.type === 'investment' ? 'active' : ''}}" data-type="investment">
        <text class="type-icon">📈</text>
        <text class="type-text">投资</text>
      </view>
    </view>
  </view>

  <!-- 名称 -->
  <view class="form-section">
    <text class="form-label">账户名称 <text class="required">*</text></text>
    <input class="form-input" placeholder="请输入账户名称" value="{{formData.name}}" bindinput="onNameInput" />
  </view>

  <!-- 图标选择 -->
  <view class="form-section">
    <text class="form-label">选择图标</text>
    <view class="emoji-grid">
      <view class="emoji-item {{formData.icon === item ? 'emoji-active' : ''}}" wx:for="{{emojiList}}" wx:key="*this" bindtap="selectIcon" data-icon="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 颜色选择 -->
  <view class="form-section">
    <text class="form-label">选择颜色</text>
    <view class="color-grid">
      <view class="color-item {{formData.color === item ? 'color-active' : ''}}" wx:for="{{colorList}}" wx:key="*this" bindtap="selectColor" data-color="{{item}}" style="background-color: {{item}}">
        <text class="color-check" wx:if="{{formData.color === item}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 初始金额（负债类显示初始负债） -->
  <view class="form-section">
    <text class="form-label">{{formData.type === 'liability' ? '初始负债' : '初始金额'}}</text>
    <block wx:if="{{!initialBalanceEditable}}">
      <view class="readonly-field">
        <text class="readonly-value">{{formData.initialBalance || '0.00'}}</text>
        <text class="adjust-btn" bindtap="showAdjustModal">调整</text>
      </view>
    </block>
    <block wx:else>
      <input class="form-input" type="digit" placeholder="0.00" value="{{formData.initialBalance}}" bindinput="onBalanceInput" focus="{{true}}" />
    </block>
  </view>

  <!-- 固定额度 (负债类显示) -->
  <view class="form-section" wx:if="{{formData.type === 'liability'}}">
    <text class="form-label">固定额度</text>
    <block wx:if="{{!creditLimitEditable}}">
      <view class="readonly-field">
        <text class="readonly-value">{{formData.creditLimit || '0.00'}}</text>
        <text class="adjust-btn" bindtap="showCreditLimitModal">调整</text>
      </view>
    </block>
    <block wx:else>
      <input class="form-input" type="digit" placeholder="0.00" value="{{formData.creditLimit}}" bindinput="onCreditLimitInput" focus="{{true}}" />
    </block>
    <text class="available-credit-hint" wx:if="{{formData.effectiveCreditLimitText}}">当前可用额度 ¥{{formData.effectiveCreditLimitText}}</text>
  </view>

  <!-- 账户备注 -->
  <view class="form-section">
    <text class="form-label">账户备注</text>
    <textarea class="form-textarea" placeholder="备注信息（选填）" value="{{formData.desc}}" bindinput="onDescInput" maxlength="200" auto-height />
  </view>

  <!-- 高级设置 -->
  <view class="form-section">
    <text class="form-label">高级设置</text>
    <view class="setting-row">
      <text class="setting-text">计入净资产</text>
      <switch checked="{{formData.includeInNetWorth}}" bindchange="onIncludeToggle" color="#07C160" />
    </view>
    <view class="setting-row">
      <text class="setting-text">允许转账</text>
      <switch checked="{{formData.allowTransfer}}" bindchange="onTransferToggle" color="#07C160" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="submit">保存修改</button>
  </view>

  <!-- 调整初始金额确认弹窗 -->
  <view class="modal-overlay" wx:if="{{showAdjustModal}}" catchtap="cancelAdjustModal">
    <view class="adjust-modal" catchtap="">
      <text class="adjust-modal-title">调整初始金额</text>
      <text class="adjust-modal-body">调整初始金额将重新计算账户余额，不影响已有交易记录。确定要调整吗？</text>
      <view class="adjust-modal-actions">
        <text class="adjust-modal-cancel" bindtap="cancelAdjustModal">取消</text>
        <text class="adjust-modal-confirm" bindtap="confirmAdjust">确定</text>
      </view>
    </view>
  </view>

  <!-- 调整固定额度确认弹窗 -->
  <view class="modal-overlay" wx:if="{{showCreditLimitModal}}" catchtap="cancelCreditLimitModal">
    <view class="adjust-modal" catchtap="">
      <text class="adjust-modal-title">调整固定额度</text>
      <text class="adjust-modal-body">调整固定额度将影响当前可用额度，不影响已有还款记录。确定要调整吗？</text>
      <view class="adjust-modal-actions">
        <text class="adjust-modal-cancel" bindtap="cancelCreditLimitModal">取消</text>
        <text class="adjust-modal-confirm" bindtap="confirmCreditLimit">确定</text>
      </view>
    </view>
  </view>
</view>
