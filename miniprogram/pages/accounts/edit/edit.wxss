/* pages/accounts/edit.wxss - 编辑账户页样式 */
@import "../create/create.wxss";

.readonly-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  border: 1px solid #E5E5E5;
  border-radius: 8px;
  padding: 0 12px;
  background: #FAFAFA;
  box-sizing: border-box;
}
.readonly-value {
  font-size: 14px;
  color: #999999;
}
.adjust-btn {
  font-size: 13px;
  color: #07C160;
  padding: 4px 8px;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.adjust-modal {
  width: 300px;
  background: #ffffff;
  border-radius: 12px;
  padding: 24px 20px 16px;
}
.adjust-modal-title {
  display: block;
  font-size: 17px;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 12px;
}
.adjust-modal-body {
  display: block;
  font-size: 14px;
  color: #666666;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 20px;
}
.adjust-modal-actions {
  display: flex;
  border-top: 1px solid #F0F0F0;
  padding-top: 12px;
}
.adjust-modal-cancel,
.adjust-modal-confirm {
  flex: 1;
  text-align: center;
  font-size: 15px;
  padding: 8px 0;
}
.adjust-modal-cancel {
  color: #999999;
}
.adjust-modal-confirm {
  color: #07C160;
  font-weight: bold;
}

.available-credit-hint {
  display: block;
  font-size: 12px;
  color: #B0B0B0;
  margin-top: 6px;
}
