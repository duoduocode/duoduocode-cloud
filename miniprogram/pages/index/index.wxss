/* 首页仪表盘样式 */

.page-scroll {
  height: 100vh;
  background: #F5F5F5;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300px;
}

.loading-text {
  color: #999999;
  font-size: 14px;
}

/* 净资产卡片 */
.networth-card {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  margin: 16px;
  padding: 24px 20px;
  border-radius: 16px;
  color: #FFFFFF;
  box-shadow: 0 4px 16px rgba(7, 193, 96, 0.3);
}

.networth-label {
  font-size: 14px;
  opacity: 0.85;
  margin-bottom: 8px;
}

.networth-value {
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 16px;
}

.networth-detail {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 10px;
  padding: 12px 16px;
}

.networth-item {
  flex: 1;
  text-align: center;
}

.networth-item-label {
  font-size: 12px;
  opacity: 0.75;
  margin-bottom: 4px;
}

.networth-item-value {
  font-size: 16px;
  font-weight: 600;
}

.networth-item-value.amount-income {
  color: #FFFFFF;
}

.networth-item-value.amount-expense {
  color: #FFD0D0;
}

.networth-item-value.amount-invest {
  color: #FFE082;
}

.networth-divider {
  width: 1px;
  height: 30px;
  background: rgba(255, 255, 255, 0.25);
}

.networth-change {
  font-size: 13px;
  margin-top: -10px;
  margin-bottom: 14px;
  opacity: 0.9;
}

.networth-change.amount-income {
  color: #FFFFFF;
}

.networth-change.amount-expense {
  color: #FFD0D0;
}

.networth-arrow {
  text-align: right;
  font-size: 12px;
  opacity: 0.7;
  margin-top: 12px;
}

/* 本月收支 */
.month-card {
  padding: 20px 16px;
}

.month-title {
  font-size: 16px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16px;
}

.month-items {
  display: flex;
}

.month-item {
  flex: 1;
  text-align: center;
}

.month-item-label {
  font-size: 13px;
  color: #999999;
  margin-bottom: 8px;
}

.month-item-value {
  font-size: 18px;
  font-weight: 600;
}

/* 今日/本周卡片 */
.today-card {
  padding: 16px;
}

.today-row {
  display: flex;
}

.today-item {
  flex: 1;
  text-align: center;
}

.today-item + .today-item {
  border-left: 1rpx solid #F0F0F0;
}

.today-item-label {
  font-size: 13px;
  color: #999999;
  margin-bottom: 6px;
}

.today-item-value {
  font-size: 17px;
  font-weight: 600;
}

/* 支出TOP5分类 */
.top-category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
}

.top-category-item + .top-category-item {
  border-top: 1rpx solid #F0F0F0;
}

.top-category-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.top-category-icon-wrap {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  flex-shrink: 0;
}

.top-category-icon {
  font-size: 18px;
}

.top-category-info {
  min-width: 0;
}

.top-category-name {
  font-size: 14px;
  color: #333333;
  font-weight: 500;
}

.top-category-count {
  font-size: 12px;
  color: #999999;
  margin-top: 2px;
}

.top-category-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12px;
  min-width: 100px;
}

.top-category-amount {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}

.top-category-bar {
  height: 4px;
  margin-bottom: 2px;
}

.progress-expense {
  background: #FA5151;
}

.top-category-percent {
  font-size: 11px;
  color: #999999;
}

/* 统计卡片 */
.stats-card {
  padding: 16px;
}

.stats-row {
  display: flex;
}

.stat-item {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #666666;
}

.stat-item + .stat-item {
  border-left: 1rpx solid #F0F0F0;
}

/* 空状态扩展 */
.empty-state-sub {
  font-size: 13px;
  color: #BBBBBB;
  margin-top: 4px;
  margin-bottom: 20px;
}
