<!-- 首页仪表盘 -->
<scroll-view scroll-y="true" class="page-scroll" refresher-enabled="true" bindrefresherrefresh="onPullDownRefresh" refresher-triggered="{{loading}}">

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-text">加载中...</view>
  </view>

  <block wx:else>

    <!-- 空状态 -->
    <view wx:if="{{monthTransactionCount === 0 && accountCount === 0}}" class="empty-state">
      <view class="empty-icon">📒</view>
      <view class="empty-text">还没有记账记录</view>
      <view class="empty-text-sub">开始记录你的每一笔收支吧</view>
      <view class="empty-btn" bindtap="goToRecord">开始记账</view>
    </view>

    <block wx:else>

      <!-- 净资产卡片 -->
      <view class="networth-card" bindtap="goToBalanceSheet">
        <view class="networth-label">净资产</view>
        <view class="networth-value">{{netWorth >= 0 ? '' : '-'}}¥{{netWorth}}</view>
        <view wx:if="{{netWorthChangePercent !== 0}}" class="networth-change {{netWorthChange >= 0 ? 'amount-income' : 'amount-expense'}}">
          {{netWorthChange >= 0 ? '↑' : '↓'}} {{netWorthChange >= 0 ? '+' : ''}}¥{{netWorthChange}} ({{netWorthChangePercent}}%)
        </view>
        <view class="networth-detail">
          <view class="networth-item">
            <view class="networth-item-label">总资产</view>
            <view class="networth-item-value amount-income">¥{{totalAssets}}</view>
          </view>
          <view class="networth-divider"></view>
          <view class="networth-item">
            <view class="networth-item-label">总负债</view>
            <view class="networth-item-value amount-expense">¥{{totalLiabilities}}</view>
          </view>
          <view class="networth-divider"></view>
          <view class="networth-item">
            <view class="networth-item-label">总投资</view>
            <view class="networth-item-value amount-invest">¥{{totalInvestments}}</view>
          </view>
        </view>
        <view class="networth-arrow">查看详情 ></view>
      </view>

      <!-- 本月收支卡片 -->
      <view class="card month-card">
        <view class="month-title">本月收支</view>
        <view class="month-items">
          <view class="month-item">
            <view class="month-item-label">收入 ({{incomeCount}}笔)</view>
            <view class="month-item-value amount-income">+¥{{totalIncome}}</view>
          </view>
          <view class="month-item">
            <view class="month-item-label">支出 ({{expenseCount}}笔)</view>
            <view class="month-item-value amount-expense">-¥{{totalExpense}}</view>
          </view>
          <view class="month-item">
            <view class="month-item-label">结余</view>
            <view class="month-item-value {{netAmount >= 0 ? 'amount-income' : 'amount-expense'}}">{{netAmount >= 0 ? '+' : ''}}¥{{netAmount}}</view>
          </view>
        </view>
      </view>

      <!-- 今日/本周 -->
      <view class="card today-card" wx:if="{{todayExpense > 0 || weekExpense > 0}}">
        <view class="today-row">
          <view class="today-item">
            <view class="today-item-label">今日支出</view>
            <view class="today-item-value amount-expense">¥{{todayExpense}}</view>
          </view>
          <view class="today-item">
            <view class="today-item-label">本周支出</view>
            <view class="today-item-value amount-expense">¥{{weekExpense}}</view>
          </view>
        </view>
      </view>

      <!-- 支出TOP5分类 -->
      <view class="card transaction-card" wx:if="{{topExpenseCategories.length > 0}}">
        <view class="section-title">支出排行 TOP{{topExpenseCategories.length}}</view>
        <block wx:for="{{topExpenseCategories}}" wx:key="categoryId">
          <view class="top-category-item">
            <view class="top-category-left">
              <view class="top-category-icon-wrap">
                <text class="top-category-icon">{{item.categoryIcon || '📋'}}</text>
              </view>
              <view class="top-category-info">
                <view class="top-category-name">{{item.categoryName}}</view>
                <view class="top-category-count">{{item.transactionCount}}笔</view>
              </view>
            </view>
            <view class="top-category-right">
              <view class="top-category-amount amount-expense">¥{{item.amount}}</view>
              <view class="progress-bar top-category-bar">
                <view class="progress-fill progress-expense" style="width: {{item.percentage}}%;"></view>
              </view>
              <view class="top-category-percent">{{item.percentage}}%</view>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{monthTransactionCount > 0}}" class="card stats-card">
        <view class="section-title">本月统计</view>
        <view class="stats-row">
          <view class="stat-item">共 {{monthTransactionCount}} 笔交易</view>
          <view class="stat-item">{{accountCount}} 个账户</view>
        </view>
      </view>

    </block>
  </block>

  <!-- 底部占位 -->
  <view style="height: 120px;"></view>

</scroll-view>

<!-- FAB 悬浮按钮 -->
<view class="fab" bindtap="goToRecord">
  <text>+</text>
</view>
