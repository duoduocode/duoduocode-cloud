/* 支出记账页样式 */

.expense-page {
  height: 100vh;
  background: #F5F5F5;
}

/* 金额输入区 */
.amount-section {
  background: #FFFFFF;
  padding: 30px 20px 24px;
  text-align: center;
  border-bottom: 1rpx solid #F0F0F0;
}

.amount-label {
  font-size: 14px;
  color: #999999;
  margin-bottom: 12px;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.amount-currency {
  font-size: 32px;
  font-weight: 700;
  color: #333333;
  margin-right: 4px;
}

.amount-input {
  font-size: 40px;
  font-weight: 700;
  color: #333333;
  min-height: 56px;
  width: auto;
  min-width: 100px;
  text-align: left;
}

/* 分录预览 */
.entry-preview {
  background: #FFFFFF;
  margin: 12px 16px;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.entry-title {
  font-size: 14px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12px;
}

.entry-table {
  font-size: 13px;
}

.entry-header {
  display: flex;
  padding-bottom: 8px;
  border-bottom: 1rpx solid #F0F0F0;
  color: #999999;
  font-size: 12px;
}

.entry-row {
  display: flex;
  padding: 10px 0;
  border-bottom: 1rpx solid #FAFAFA;
}

.entry-col-account {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-col-debit {
  width: 100px;
  text-align: right;
  flex-shrink: 0;
}

.entry-col-credit {
  width: 100px;
  text-align: right;
  flex-shrink: 0;
}

.entry-tag {
  display: inline-block;
  width: 18px;
  height: 18px;
  line-height: 18px;
  text-align: center;
  border-radius: 4px;
  font-size: 11px;
  color: #FFFFFF;
  margin-right: 4px;
  vertical-align: middle;
}

.entry-tag-debit {
  background: #07C160;
}

.entry-tag-credit {
  background: #FA5151;
}

/* 表单区域 */
.form-section {
  margin: 12px 0;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 16px;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-item:first-child {
  border-top: 1rpx solid #F0F0F0;
}

.form-item-left {
  width: 120px;
  flex-shrink: 0;
}

.form-item-label {
  font-size: 15px;
  color: #333333;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.form-item-desc {
  font-size: 12px;
  color: #BBBBBB;
  margin-top: 2px;
}

.form-tag {
  display: inline-block;
  width: 20px;
  height: 20px;
  line-height: 20px;
  text-align: center;
  border-radius: 4px;
  font-size: 12px;
  color: #FFFFFF;
  margin-right: 6px;
}

.form-tag-debit {
  background: #07C160;
}

.form-tag-credit {
  background: #FA5151;
}

.form-item-right {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
  min-width: 0;
}

.form-item-selected {
  font-size: 15px;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-item-placeholder {
  font-size: 15px;
  color: #BBBBBB;
}

.form-item-value {
  font-size: 15px;
  color: #333333;
}

.form-item-arrow {
  color: #CCCCCC;
  margin-left: 8px;
  font-size: 14px;
  flex-shrink: 0;
}

.form-item-notes .form-item-right {
  flex: 1;
}

.desc-input {
  text-align: right;
  font-size: 15px;
  color: #333333;
  width: 100%;
}

/* 操作按钮 */
.btn-group {
  padding: 24px 16px;
}

.btn-save {
  width: 100%;
  height: 48px;
  line-height: 1;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 12px;
  font-size: 17px;
  font-weight: 600;
  border: none;
  margin-bottom: 12px;
}

.btn-save::after { border: none; }

.btn-save[disabled] {
  background: #AEE8C8;
}

.btn-cancel {
  width: 100%;
  height: 48px;
  line-height: 1;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  color: #999999;
  border-radius: 12px;
  font-size: 16px;
  border: none;
}

.btn-cancel::after { border: none; }

/* === 弹窗通用 === */
.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12px;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 8px;
}

.sheet-title {
  font-size: 17px;
  font-weight: 600;
  color: #333333;
}

.sheet-close {
  font-size: 15px;
  color: #07C160;
}

.sheet-body {
  max-height: 50vh;
}

.sheet-empty {
  text-align: center;
  padding: 40px 0;
  color: #999999;
  font-size: 14px;
}

/* 选择列表项 */
.sheet-item {
  display: flex;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1rpx solid #FAFAFA;
}

.sheet-item-active {
  background: #F0FFF5;
  margin: 0 -16px;
  padding: 14px 16px;
}

.sheet-item-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.sheet-hint {
  font-size: 11px;
  color: #B0B0B0;
  flex: 1;
  margin-left: 10px;
}

.sheet-item-icon {
  font-size: 24px;
  margin-right: 12px;
}

.sheet-item-info {
  flex: 1;
}

.sheet-item-name {
  font-size: 15px;
  color: #333333;
  display: block;
}

.sheet-item-sub {
  font-size: 12px;
  color: #999999;
  margin-top: 2px;
}

.sheet-item-check {
  color: #07C160;
  font-size: 18px;
  font-weight: 700;
}

/* 分类选择器 */
.category-sheet {
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  width: 100%;
  padding: 16px;
}

.category-picker-body {
  display: flex;
  height: 50vh;
  overflow: hidden;
  flex-shrink: 0;
}

.category-parent-list {
  width: 120px;
  background: #F5F5F5;
  height: 100%;
  flex-shrink: 0;
}

.category-parent-item {
  padding: 14px 12px;
  font-size: 14px;
  color: #666666;
  border-bottom: 1rpx solid #EEEEEE;
}

.category-parent-active {
  background: #FFFFFF;
  color: #07C160;
  font-weight: 600;
}

.category-child-list {
  flex: 1;
  height: 100%;
  padding: 0 12px;
}

.category-parent-text {
  display: inline-block;
  line-height: 1.4;
}

.category-child-item {
  padding: 14px 8px;
  font-size: 14px;
  color: #333333;
  border-bottom: 1rpx solid #FAFAFA;
}

.category-child-active {
  color: #07C160;
  background: #F0FFF5;
  margin: 0 -12px;
  padding: 14px 20px;
  border-radius: 6px;
}

/* 标签网格 */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12px 0;
  max-height: 40vh;
  overflow-y: auto;
}

.tag-item {
  padding: 8px 18px;
  background: #F5F5F5;
  border-radius: 20px;
  font-size: 14px;
  color: #666666;
  margin: 6px;
}

.tag-item-active {
  background: #07C160;
  color: #FFFFFF;
}
