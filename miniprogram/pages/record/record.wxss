/* 记账类型选择页 */

.record-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 20px 16px;
}

.record-header {
  margin-bottom: 24px;
}

.record-title {
  font-size: 24px;
  font-weight: 700;
  color: #333333;
  margin-bottom: 6px;
}

.record-subtitle {
  font-size: 14px;
  color: #999999;
}

/* 类型卡片 */
.type-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.type-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 20px 16px;
  border-left: 5px solid;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  transition: transform 0.15s ease;
}

.type-card:active {
  transform: scale(0.98);
}

.type-icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.type-icon {
  font-size: 26px;
}

.type-info {
  flex: 1;
  margin-left: 14px;
}

.type-name {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 4px;
}

.type-desc {
  font-size: 13px;
  color: #999999;
}

.type-arrow {
  color: #CCCCCC;
  font-size: 16px;
  flex-shrink: 0;
}

/* 完整复式模式入口 */
.fullmode-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40px;
  margin-bottom: 8px;
}

.fullmode-line {
  width: 40px;
  height: 1px;
  background: #D5D5D5;
}

.fullmode-text {
  margin: 0 16px;
  font-size: 14px;
  color: #576B95;
}

.fullmode-desc {
  text-align: center;
  font-size: 12px;
  color: #BBBBBB;
}
