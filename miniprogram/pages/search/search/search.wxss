/* pages/search/search/search.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}

/* 搜索栏 */
.search-header {
  display: flex;
  align-items: center;
  padding: 10px 16px;
  background: #fff;
  gap: 10px;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F0F0F0;
  border-radius: 20px;
  padding: 0 12px;
  height: 36px;
}

.search-icon {
  font-size: 14px;
  margin-right: 6px;
}

.search-input {
  flex: 1;
  font-size: 14px;
  height: 100%;
}

.filter-toggle {
  font-size: 14px;
  color: #07C160;
  padding: 0 4px;
}

/* 筛选面板 */
.filter-panel {
  background: #fff;
  padding: 0 16px 16px;
  border-bottom: 1px solid #f0f0f0;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
}

.filter-label {
  font-size: 14px;
  color: #666;
  width: 50px;
  flex-shrink: 0;
}

.filter-dates {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  justify-content: flex-end;
}

.date-picker {
  padding: 6px 10px;
  background: #F5F5F5;
  border-radius: 6px;
  font-size: 13px;
  color: #333;
}

.date-sep {
  color: #999;
  font-size: 13px;
}

.amount-picker {
  width: 80px;
  height: 30px;
  background: #F5F5F5;
  border-radius: 6px;
  padding: 0 8px;
  font-size: 13px;
  text-align: center;
}

.picker-val {
  padding: 6px 10px;
  background: #F5F5F5;
  border-radius: 6px;
  font-size: 13px;
  color: #333;
}

.filter-actions {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.filter-reset {
  flex: 1;
  text-align: center;
  padding: 8px;
  background: #F5F5F5;
  border-radius: 8px;
  font-size: 14px;
  color: #666;
}

.filter-apply {
  flex: 2;
  text-align: center;
  padding: 8px;
  background: #07C160;
  border-radius: 8px;
  font-size: 14px;
  color: #fff;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  background: #fff;
  padding: 8px 16px;
  gap: 20px;
}

.sort-item {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 14px;
  color: #999;
  padding: 4px 0;
}

.sort-item.active {
  color: #07C160;
  font-weight: 500;
}

.sort-arrow {
  font-size: 11px;
}

/* 结果列表 */
.result-scroll {
  flex: 1;
  padding: 8px 16px;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 8px;
}

.tx-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.tx-left {
  flex: 1;
}

.tx-category {
  font-size: 15px;
  font-weight: 500;
  color: #333;
  display: block;
}

.tx-desc {
  font-size: 13px;
  color: #999;
  display: block;
  margin-top: 4px;
}

.tx-date {
  font-size: 12px;
  color: #ccc;
  display: block;
  margin-top: 4px;
}

.tx-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12px;
}

.tx-amount {
  font-size: 17px;
  font-weight: 600;
  display: block;
}

.tx-amount.expense {
  color: #FA5151;
}

.tx-amount.income {
  color: #07C160;
}

.tx-account {
  font-size: 12px;
  color: #999;
  display: block;
  margin-top: 4px;
}

/* 加载/空状态 */
.loading-tip {
  text-align: center;
  padding: 16px;
  font-size: 13px;
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 60px 0;
  color: #999;
  font-size: 15px;
}
