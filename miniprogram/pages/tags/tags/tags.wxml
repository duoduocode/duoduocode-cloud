<!-- pages/tags/tags/tags.wxml -->
<view class="container">
  <!-- 标签列表 -->
  <scroll-view class="tag-scroll" scroll-y="true">
    <block wx:if="{{tags.length > 0}}">
      <view class="tag-item" wx:for="{{tags}}" wx:key="id" bindtap="openEdit" data-tag="{{item}}">
        <view class="tag-left">
          <view class="tag-dot" style="background-color: {{item.color}}"></view>
          <text class="tag-name">{{item.name}}</text>
        </view>
        <view class="tag-right">
          <text class="tag-count">{{item.usageCount || 0}}次</text>
          <text class="tag-del" catchtap="deleteTag" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="empty-tip">暂无标签，点击下方按钮创建</view>
    </block>
  </scroll-view>

  <!-- 新建按钮 -->
  <view class="create-btn" bindtap="openCreate">
    <text>+ 新建标签</text>
  </view>

  <!-- 弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal"></view>
  <view class="modal-panel" wx:if="{{showModal}}">
    <view class="modal-header">
      <text class="modal-title">{{editingTag ? '编辑标签' : '新建标签'}}</text>
      <text class="modal-close" bindtap="closeModal">X</text>
    </view>
    <view class="modal-body">
      <input class="name-input" placeholder="标签名称" value="{{newName}}" bindinput="onNameInput" maxlength="10"/>
      <view class="color-selector">
        <text class="color-label">选择颜色</text>
        <view class="color-grid">
          <view class="color-item {{item === selectedColor ? 'selected' : ''}}"
                wx:for="{{colorList}}" wx:key="*this"
                bindtap="selectColor" data-color="{{item}}"
                style="background-color: {{item}}">
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <view class="btn-cancel" bindtap="closeModal">取消</view>
      <view class="btn-confirm" bindtap="saveTag">确定</view>
    </view>
  </view>
</view>
