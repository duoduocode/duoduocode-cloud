/* pages/tags/tags/tags.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}

.tag-scroll {
  flex: 1;
  padding: 12px 16px;
}

.tag-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 16px;
  border-radius: 12px;
  margin-bottom: 8px;
}

.tag-left {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
}

.tag-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  flex-shrink: 0;
}

.tag-name {
  font-size: 15px;
  color: #333;
}

.tag-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.tag-count {
  font-size: 13px;
  color: #999;
}

.tag-del {
  font-size: 13px;
  color: #FA5151;
  padding: 4px 8px;
}

/* 创建按钮 */
.create-btn {
  background: #07C160;
  color: #fff;
  text-align: center;
  padding: 14px;
  margin: 12px 16px 24px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
}

.empty-tip {
  text-align: center;
  padding: 60px 0;
  color: #999;
  font-size: 15px;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.modal-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  z-index: 101;
  padding: 20px 16px 32px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.modal-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 18px;
  color: #999;
  padding: 4px 8px;
}

.name-input {
  width: 100%;
  height: 44px;
  background: #F5F5F5;
  border-radius: 8px;
  padding: 0 14px;
  font-size: 15px;
  box-sizing: border-box;
  margin-bottom: 16px;
}

.color-label {
  font-size: 14px;
  color: #999;
  display: block;
  margin-bottom: 10px;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.color-item {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid transparent;
}

.color-item.selected {
  border-color: #333;
  transform: scale(1.15);
}

.modal-footer {
  display: flex;
  gap: 12px;
  margin-top: 24px;
}

.btn-cancel {
  flex: 1;
  text-align: center;
  padding: 12px;
  background: #F5F5F5;
  border-radius: 8px;
  font-size: 15px;
  color: #666;
}

.btn-confirm {
  flex: 1;
  text-align: center;
  padding: 12px;
  background: #07C160;
  border-radius: 8px;
  font-size: 15px;
  color: #fff;
}
