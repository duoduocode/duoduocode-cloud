/* pages/budget/special/create/create.wxss */
.container {
  padding: 16px;
  background: #F5F5F5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 0 16px;
  margin-bottom: 12px;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
}

.form-item.column {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  font-size: 15px;
  color: #333;
  flex-shrink: 0;
  margin-bottom: 0;
}

.form-item.column .form-label {
  margin-bottom: 10px;
}

.form-divider {
  height: 1px;
  background: #F0F0F0;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  gap: 4px;
}

.prefix {
  font-size: 15px;
  color: #999;
}

.form-input {
  width: 200px;
  height: 36px;
  background: #F5F5F5;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  text-align: right;
  color: #333;
}

.form-textarea {
  width: 100%;
  height: 80px;
  background: #F5F5F5;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  color: #333;
  box-sizing: border-box;
}

.picker-value {
  font-size: 15px;
  color: #333;
  padding: 8px 12px;
  background: #F5F5F5;
  border-radius: 8px;
  min-width: 140px;
  text-align: center;
}

/* 分类多选 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  width: 100%;
}

.cat-chip {
  padding: 8px 16px;
  background: #F5F5F5;
  border-radius: 20px;
  font-size: 13px;
  color: #666;
  border: 1px solid transparent;
}

.cat-chip.selected {
  background: #E8F8EF;
  color: #07C160;
  border-color: #07C160;
}

.empty-tip {
  font-size: 13px;
  color: #999;
  padding: 12px 0;
}

/* 提交按钮 */
.submit-btn {
  background: #07C160;
  color: #fff;
  text-align: center;
  padding: 14px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 16px;
}

.submit-btn.disabled {
  background: #ccc;
}
