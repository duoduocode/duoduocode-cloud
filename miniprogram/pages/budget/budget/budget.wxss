/* pages/budget/budget/budget.wxss */
.container {
  padding: 16px;
  background: #F5F5F5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

/* 月度预算环形图 */
.budget-ring-card {
  display: flex;
  align-items: center;
  gap: 24px;
}

.ring-wrapper {
  flex-shrink: 0;
}

.ring-bg {
  width: 140px;
  height: 140px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-canvas {
  width: 140px;
  height: 140px;
}

.ring-center {
  position: absolute;
  text-align: center;
}

.ring-percent {
  font-size: 26px;
  font-weight: bold;
  color: #333;
}

.ring-label {
  font-size: 12px;
  color: #999;
}

.budget-info {
  flex: 1;
}

.budget-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
}

.budget-row:last-child {
  border-bottom: none;
}

.budget-label {
  font-size: 14px;
  color: #999;
}

.budget-value {
  font-size: 16px;
  color: #333;
  font-weight: 500;
}

.budget-value.expense {
  color: #FA5151;
}

.budget-value.remaining {
  color: #07C160;
}

/* 周度预算 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #333;
}

.card-sub {
  font-size: 13px;
  color: #999;
}

/* 进度条 */
.progress-bar {
  height: 8px;
  background: #F0F0F0;
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #07C160;
  border-radius: 4px;
  transition: width 0.3s ease;
}

.progress-fill.warn {
  background: #FF9800;
}

/* 结转卡片 */
.carryover-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #E8F8EF, #FFFFFF);
  border: 1px solid #D4F0E0;
}

.carryover-info {
  display: flex;
  align-items: center;
  gap: 8px;
}

.carryover-label {
  font-size: 14px;
  color: #333;
}

.carryover-amount {
  font-size: 18px;
  font-weight: bold;
  color: #07C160;
}

.carryover-count {
  font-size: 12px;
  color: #999;
}

.arrow {
  color: #ccc;
  font-size: 16px;
}

/* 操作入口 */
.action-row {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.action-btn {
  flex: 1;
  background: #fff;
  border-radius: 12px;
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.action-icon {
  width: 40px;
  height: 40px;
  background: #E8F8EF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #07C160;
  font-weight: bold;
}

.action-text {
  font-size: 13px;
  color: #333;
}

/* 专项预算区域 */
.section {
  margin-bottom: 16px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4px 12px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 13px;
  color: #07C160;
}

.special-item .special-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.special-name {
  font-size: 15px;
  color: #333;
  font-weight: 500;
}

.special-amount {
  font-size: 13px;
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 32px 0;
  color: #999;
  font-size: 14px;
}

/* 创建按钮 */
.create-btn {
  background: #07C160;
  color: #fff;
  text-align: center;
  padding: 14px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 8px;
}
