/* pages/budget/daily/daily.wxss */
.container {
  padding: 16px;
  background: #F5F5F5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12px;
}

.month-display {
  font-size: 24px;
  font-weight: bold;
  color: #07C160;
  text-align: center;
  padding: 8px 0;
}

/* 表单行 */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row.sub {
  padding: 8px 0;
  border-bottom: 1px solid #f9f9f9;
}

.form-label {
  font-size: 15px;
  color: #333;
  flex-shrink: 0;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  gap: 4px;
}

.prefix {
  font-size: 15px;
  color: #999;
}

.suffix {
  font-size: 13px;
  color: #999;
  margin-left: 4px;
}

.form-input {
  width: 160px;
  height: 36px;
  background: #F5F5F5;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  text-align: right;
  color: #333;
}

.form-input.small {
  width: 120px;
}

/* 分类项 */
.category-item {
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.category-item:last-child {
  border-bottom: none;
}

.cat-header {
  margin-bottom: 8px;
}

.cat-name {
  font-size: 15px;
  font-weight: 500;
  color: #333;
}

.cat-form {
  padding-left: 12px;
}

.empty-tip {
  text-align: center;
  padding: 24px 0;
  color: #999;
  font-size: 14px;
}

/* 保存按钮 */
.save-btn {
  background: #07C160;
  color: #fff;
  text-align: center;
  padding: 14px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 16px;
}
