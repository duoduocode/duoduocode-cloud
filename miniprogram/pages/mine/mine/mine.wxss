/* pages/mine/mine/mine.wxss */
.container {
  padding: 0 16px;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 头像区域 */
.header-card {
  display: flex;
  align-items: center;
  padding: 32px 16px 24px;
  gap: 16px;
}

.avatar-wrap {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  overflow: hidden;
  background: #E8F8EF;
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 20px;
  font-weight: 600;
  color: #333;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12px;
  padding: 20px 16px;
  margin-bottom: 16px;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 20px;
  font-weight: 700;
  color: #333;
  display: block;
}

.stat-num.positive {
  color: #07C160;
}

.stat-num.negative {
  color: #FA5151;
}

.stat-label {
  font-size: 12px;
  color: #999;
  display: block;
  margin-top: 4px;
}

.stat-divider {
  width: 1px;
  height: 32px;
  background: #f0f0f0;
}

/* 菜单区域 */
.menu-section {
  margin-bottom: 12px;
}

.menu-title {
  font-size: 13px;
  color: #999;
  padding: 0 4px 8px;
}

.menu-list.card {
  background: #fff;
  border-radius: 12px;
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
  gap: 12px;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 32px;
  height: 32px;
  background: #F0F0F0;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #666;
  flex-shrink: 0;
}

.menu-name {
  flex: 1;
  font-size: 15px;
  color: #333;
}

.menu-arrow {
  font-size: 14px;
  color: #ccc;
}

/* 底部 */
.bottom-space {
  height: 40px;
}
