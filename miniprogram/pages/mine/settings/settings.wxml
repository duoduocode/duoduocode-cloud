<!-- pages/mine/settings/settings.wxml -->
<view class="container">
  <view class="menu-section">
    <view class="menu-title">账户安全</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goChangePassword">
        <text class="menu-name">修改密码</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goSecuritySettings">
        <text class="menu-name">安全设置</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">通知设置</view>
    <view class="menu-list">
      <view class="menu-item">
        <text class="menu-name">记账提醒</text>
        <switch checked="{{noticeEnabled}}" bindchange="onNoticeToggle" color="#07C160"/>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">隐私设置</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goPrivacy">
        <text class="menu-name">隐私政策</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goAgreement">
        <text class="menu-name">用户协议</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">数据管理</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="exportData">
        <text class="menu-name">导出数据</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="clearData">
        <text class="menu-name">清除数据</text>
        <text class="menu-desc">清除所有本地缓存</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">关于</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goAbout">
        <text class="menu-name">关于借贷记</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item">
        <text class="menu-name">当前版本</text>
        <text class="menu-desc">v1.0.0</text>
      </view>
    </view>
  </view>
</view>
