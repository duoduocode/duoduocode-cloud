<!-- pages/templates/templates/templates.wxml -->
<view class="container">
  <scroll-view class="list-scroll" scroll-y="true">
    <block wx:if="{{templates.length > 0}}">
      <view class="template-card card" wx:for="{{templates}}" wx:key="id" bindtap="goEdit" data-id="{{item.id}}">
        <view class="card-top">
          <view class="template-info">
            <text class="template-name">{{item.name}}</text>
            <text class="template-amount {{item.transactionType === 'expense' ? 'expense' : 'income'}}">
              {{item.transactionType === 'expense' ? '-' : '+'}}￥{{item.amount}}
            </text>
          </view>
          <switch checked="{{item.active}}" bindchange="toggleActive" data-id="{{item.id}}" data-active="{{item.active}}" color="#07C160"/>
        </view>
        <view class="card-meta">
          <text class="meta-item">{{item.frequencyText}}</text>
          <text class="meta-item">{{item.categoryName}}</text>
          <text class="meta-item" wx:if="{{item.accountName}}">{{item.accountName}}</text>
        </view>
        <view class="card-bottom">
          <text class="next-date">下次: {{item.nextDate}}</text>
          <text class="delete-btn" catchtap="deleteTemplate" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="empty-tip">暂无周期模板，点击下方按钮创建</view>
    </block>
  </scroll-view>

  <view class="create-btn" bindtap="goCreate">
    <text>+ 新建周期模板</text>
  </view>
</view>
