/* pages/templates/create/create.wxss */
.container {
  padding: 16px;
  background: #F5F5F5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 0 16px;
  margin-bottom: 12px;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.column {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  font-size: 15px;
  color: #333;
  flex-shrink: 0;
}

.form-label.required::after {
  content: ' *';
  color: #FA5151;
}

.form-input {
  width: 200px;
  height: 36px;
  background: #F5F5F5;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  text-align: right;
  color: #333;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  gap: 4px;
}

.prefix {
  font-size: 15px;
  color: #999;
}

.picker-value {
  font-size: 15px;
  color: #333;
  padding: 8px 12px;
  background: #F5F5F5;
  border-radius: 8px;
  min-width: 120px;
  text-align: center;
}

.type-radio-group {
  display: flex;
  gap: 8px;
  padding: 8px 0;
  width: 100%;
}

.type-radio {
  padding: 8px 24px;
  border-radius: 8px;
  background: #F5F5F5;
  font-size: 14px;
  color: #666;
}

.type-radio.active {
  background: #07C160;
  color: #fff;
}

.termination-group {
  width: 100%;
}

.termination-option {
  display: flex;
  align-items: center;
  padding: 8px 0;
  gap: 12px;
}

.termination-count-input {
  width: 80px;
  height: 32px;
  background: #F5F5F5;
  border-radius: 6px;
  padding: 0 8px;
  font-size: 14px;
  text-align: center;
}

.termination-date-picker {
  font-size: 14px;
  color: #333;
  padding: 6px 12px;
  background: #F5F5F5;
  border-radius: 6px;
}

/* 提交 */
.submit-btn {
  background: #07C160;
  color: #fff;
  text-align: center;
  padding: 14px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 500;
  margin-top: 16px;
}
