/* 全局样式 */
page {
  --primary: #07C160;
  --primary-dark: #06AD56;
  --link: #576B95;
  --bg: #F5F5F5;
  --text: #333333;
  --text-secondary: #999999;
  --text-light: #BBBBBB;
  --danger: #FA5151;
  --warning: #FF9800;
  --income: #07C160;
  --expense: #FA5151;
  --white: #FFFFFF;
  --border: #E5E5E5;
  --shadow: 0 2px 12px rgba(0,0,0,0.06);
  --radius: 12px;
  --radius-sm: 8px;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 16px;
  color: var(--text);
  background-color: var(--bg);
  box-sizing: border-box;
  line-height: 1.5;
}

/* 通用卡片 */
.card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 16px;
  margin: 12px 16px;
  box-shadow: var(--shadow);
}

/* 通用按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: 16px;
  padding: 12px 24px;
  border: none;
  font-weight: 500;
}
.btn::after { border: none; }

.btn-primary {
  background: var(--primary);
  color: white;
}

.btn-danger {
  background: var(--danger);
  color: white;
}

.btn-block {
  display: flex;
  width: calc(100% - 32px);
  margin: 16px;
}

/* 通用列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  background: var(--white);
  border-bottom: 1rpx solid var(--border);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
}
.empty-icon { font-size: 48px; margin-bottom: 12px; }
.empty-text { color: var(--text-secondary); font-size: 14px; margin-bottom: 16px; }
.empty-btn {
  background: var(--primary);
  color: white;
  padding: 10px 24px;
  border-radius: 20px;
  font-size: 14px;
}

/* 金额颜色 */
.amount-income { color: var(--income); font-weight: 600; }
.amount-expense { color: var(--expense); font-weight: 600; }
.amount-neutral { color: var(--text); font-weight: 600; }

/* 标签 */
.tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 12px;
  margin-right: 6px;
  margin-bottom: 6px;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 底部弹窗 */
.bottom-sheet {
  background: var(--white);
  border-radius: 16px 16px 0 0;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 16px;
}

/* 进度条 */
.progress-bar {
  height: 6px;
  background: var(--border);
  border-radius: 3px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 3px;
  background: var(--primary);
  transition: width 0.3s ease;
}
.progress-warning { background: var(--warning); }
.progress-danger { background: var(--danger); }

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  margin: 12px 16px;
}
.search-bar input {
  flex: 1;
  font-size: 14px;
  background: none;
  border: none;
  outline: none;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 8px 0;
}

/* FAB 悬浮按钮 */
.fab {
  position: fixed;
  right: 20px;
  bottom: 120px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  box-shadow: 0 4px 16px rgba(7,193,96,0.4);
  z-index: 100;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 0 16px;
  background: var(--white);
  border-bottom: 1rpx solid var(--border);
  position: relative;
}
.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--text);
}
.nav-back {
  position: absolute;
  left: 16px;
  font-size: 14px;
  color: var(--link);
}
